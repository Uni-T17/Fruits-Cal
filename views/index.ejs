<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/main.css" />
    <title>Fruit Calculator</title>
  </head>
  <body>
    <div class="page">
      <h1>🍉 Fruit Calculator</h1>
      <p class="subtitle">Welcome, <%= name %>! Pick a fruit to see its nutrition facts.</p>

      <ul class="fruit-grid">
        <% fruits.forEach(function(fruit, i) { %>
          <li class="fruit-card" style="--accent-index: <%= i % 6 %>;">
            <p class="fruit-name"><%= fruit.name %></p>
            <p class="fruit-family"><%= fruit.family %></p>
            <a class="btn" href="/fruits/<%= fruit.name %>">View Details</a>
          </li>
        <% }); %>
      </ul>
    </div>
  </body>
</html>
